# ============================================================
# 生活改善AI - 環境変数設定ファイル
# Vercelダッシュボードの Environment Variables にこれらを設定
# ============================================================

# ---- Gemini API (複数キーはカンマ区切りで) ----
# Google AI Studio (https://aistudio.google.com) で取得
GEMINI_API_KEYS=AIzaSy...,AIzaSy...,AIzaSy...

# ---- JWT認証 ----
# openssl rand -base64 32 で生成した32文字以上のランダム文字列
JWT_SECRET=your-super-secret-jwt-key-minimum-32-characters

# ---- PHPデータサーバー ----
DATA_SERVER_URL=https://data.example.com/ai-schedule
# 同じ値をPHPサーバーの環境変数にも設定すること
API_SECRET=your-api-secret-key-for-internal-communication

# ---- LINE Bot ----
# LINE Developers Console (https://developers.line.biz) で取得
LINE_CHANNEL_SECRET=your-line-channel-secret
LINE_CHANNEL_ACCESS_TOKEN=your-line-channel-access-token

# ============================================================
# PHPサーバー (.env または直接定数として設定)
# ============================================================
# API_SECRET=上記と同じ値
